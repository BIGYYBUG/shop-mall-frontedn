# ============================================================
#  shopping-mall-frontend  .gitignore
# ============================================================

# ---- 依赖 ----
# node_modules 动辄上万文件、几百 MB，且完全可由 package-lock.json 还原。
node_modules/

# ---- 构建产物 ----
dist/
dist-ssr/
*.local

# ---- IDE ----
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ---- 日志 ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# ---- 操作系统 ----
.DS_Store
Thumbs.db

# ---- 本地工具数据（工作区记忆等，属于本机状态，不参与协作）----
.workbuddy/

# ---- 本地环境变量 ----
.env
.env.local
.env.*.local

# ---- Windows 保留名误建文件 ----
# 起因：bash 下写 `2>nul` 时，nul 不会被当成设备，而是被当成普通文件名，
# 于是仓库根目录被建出一个名为 NUL 的文件。它是 Windows 保留设备名，
# 常规手段删不掉也改不了名（PowerShell / git clean 均报 Permission denied）。
# 只能忽略；如需彻底清理，请用「管理员」cmd 执行：
#   del "\\?\E:\Projects\shopping-mall-frontend\NUL"
NUL
nul
