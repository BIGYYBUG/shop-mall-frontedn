# ============================================================
#  shopping-mall-frontend  .gitignore
# ============================================================

# ---- 依赖 ----
# node_modules 动辄上万文件、几百 MB，且完全可由 package-lock.json 还原。
node_modules/

# ---- 构建产物 ----
dist/
dist-ssr/
*.local

# ---- IDE ----
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ---- 日志 ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# ---- 操作系统 ----
.DS_Store
Thumbs.db

# ---- 本地工具数据（工作区记忆等，属于本机状态，不参与协作）----
.workbuddy/

# ---- 本地环境变量 ----
.env
.env.local
.env.*.local
